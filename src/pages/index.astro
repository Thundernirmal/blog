---
import { BookOpenIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import TagList from '@/components/blog/TagList.astro';
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';
import { SITE } from '@/config';
import { formatDate } from '@/lib/dates';
import { getPostReadingTime, getPostUrl, getPublishedPosts } from '@/lib/content';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  author: { '@type': 'Person', name: SITE.author, url: SITE.authorUrl },
};
---

<BaseLayout title={SITE.name} canonicalPath="/" structuredData={structuredData}>
  <PageHeader id="home-page-header" title={SITE.name} eyebrow="~/notes" hero>
    <p>{SITE.description}</p>
  </PageHeader>

  <section class="grid gap-6" aria-labelledby="latest-writing">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div class="grid gap-3">
        <h2 id="latest-writing" class="display wrap-anywhere text-4xl sm:text-5xl">Latest Writing</h2>
        <p class="text-muted-foreground">Long-form notes, practical guides, and ideas worth keeping.</p>
      </div>
      <a class="home-cta label" href="/rss.xml">RSS <span class="home-cta-arrow" aria-hidden="true">→</span></a>
    </div>

    {latestPosts.length > 0 ? (
      /* The portfolio's playground band: numbered cells divided by hairline rules, each ending in a label link. */
      <ol class="home-band" data-reveal-list>
        {latestPosts.map((post, index) => (
          <li class="home-cell">
            <article class="contents">
              <p class="label text-muted-foreground"><span class="font-mono text-primary">{String(index + 1).padStart(2, '0')}</span> / <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time> · {getPostReadingTime(post)} min</p>
              <h3 class="text-balance wrap-anywhere text-2xl leading-tight font-medium tracking-[-0.025em]">
                <a class="outline-none hover:text-primary focus-visible:ring-3 focus-visible:ring-ring" href={getPostUrl(post)}>{post.data.title}</a>
              </h3>
              <p class="flex-1 text-pretty leading-7 text-muted-foreground">{post.data.description}</p>
              <TagList tags={post.data.tags} limit={3} />
              <a class="home-cta label" href={getPostUrl(post)}>
                <span>Read article<span class="sr-only">: {post.data.title}</span></span>
                <span class="home-cta-arrow" aria-hidden="true">→</span>
              </a>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <Empty className="border">
        <EmptyHeader>
          <EmptyMedia variant="icon"><BookOpenIcon aria-hidden="true" /></EmptyMedia>
          <EmptyTitle>No Articles Yet</EmptyTitle>
          <EmptyDescription>New writing is on the way.</EmptyDescription>
        </EmptyHeader>
      </Empty>
    )}

    <a class="home-cta label w-fit gap-3" href="/blog/">View All {posts.length} Articles <span class="home-cta-arrow" aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
