---
import { ExternalLinkIcon, GlobeIcon, MonitorIcon, RssIcon, Code2Icon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import LabelLink from '@/components/LabelLink.astro';
import { SITE } from '@/config';
---

<BaseLayout
  title="About"
  description={`Meet ${SITE.author}, a systems engineer, Linux enthusiast, and the author of ${SITE.name}.`}
  canonicalPath="/about/"
>
  <PageHeader title="About" eyebrow="nirmal@Tiger">
    <p>The person behind the notes, the systems behind the work, and the hardware rabbit holes along the way.</p>
  </PageHeader>

  {/* Two cells of the portfolio's ruled band instead of raised cards, each ending in label links. */}
  <div class="home-band lg:grid-cols-2" data-reveal-list>
    <section class="home-cell" aria-labelledby="about-author">
      <p class="label text-muted-foreground"><span class="font-mono text-primary">01</span> / Author</p>
      <h2 id="about-author" class="display text-4xl sm:text-5xl">Nirmal Katariya</h2>
      <p class="text-muted-foreground">Systems engineer in site reliability · B.Tech in Computer Science, IIT Jodhpur</p>
      <p class="leading-7 text-muted-foreground">I’m a systems engineer in site reliability, supporting production infrastructure for straight-through processing applications. I build the tooling that keeps it healthy: SLOs, Prometheus, Alertmanager and BigQuery.</p>
      <dl class="grid gap-4 leading-7 text-muted-foreground">
        <div class="grid gap-1">
          <dt class="label text-foreground">Expertise</dt>
          <dd>SRE, SLOs &amp; SLIs, Prometheus, Alertmanager, BigQuery, Linux, and Python</dd>
        </div>
        <div class="grid gap-1">
          <dt class="label text-foreground">Currently</dt>
          <dd>Production support and SRE development.</dd>
        </div>
        <div class="grid gap-1">
          <dt class="label text-foreground">Education</dt>
          <dd>B.Tech in Computer Science from IIT Jodhpur</dd>
        </div>
      </dl>
      <div class="mt-auto flex flex-wrap gap-x-6">
        <LabelLink href={SITE.authorUrl} icon={GlobeIcon}>Personal Site</LabelLink>
        <LabelLink href={SITE.retroUrl} icon={MonitorIcon}>Retro Site</LabelLink>
      </div>
    </section>

    <section class="home-cell" aria-labelledby="about-notes">
      <p class="label text-muted-foreground"><span class="font-mono text-primary">02</span> / Blog</p>
      <h2 id="about-notes" class="display text-4xl sm:text-5xl">Nirmal’s Notes</h2>
      <p class="text-muted-foreground">Practical writing about software, hardware, Linux, and the tools in between.</p>
      <p class="leading-7 text-muted-foreground">This is where I keep useful tools, explored systems, and technical ideas that deserve more room than a terminal scrollback.</p>
      <p class="leading-7 text-muted-foreground">The blog shares the personal sites’ love of Linux, hardware, and terminal-inspired design, built with Astro, Catppuccin Latte and Mocha, and as little client JavaScript as possible.</p>
      <div class="mt-auto flex flex-wrap gap-x-6">
        <LabelLink href="/rss.xml" icon={RssIcon}>RSS Feed</LabelLink>
        <LabelLink href={SITE.githubUrl} icon={Code2Icon}>GitHub</LabelLink>
        <LabelLink href={SITE.mediumUrl} icon={ExternalLinkIcon}>Medium</LabelLink>
      </div>
    </section>
  </div>
</BaseLayout>
