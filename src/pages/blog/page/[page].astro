---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PostCard from '@/components/blog/PostCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { POSTS_PER_PAGE } from '@/config';
import { getPublishedPosts, type BlogPost } from '@/lib/content';

interface Props {
  posts: BlogPost[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * POSTS_PER_PAGE;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(start, start + POSTS_PER_PAGE),
        currentPage,
        totalPages,
        totalPosts: posts.length,
      },
    };
  });
}

const { posts, currentPage, totalPages, totalPosts } = Astro.props;
---

<BaseLayout title={`Blog — Page ${currentPage}`} description={`Article archive page ${currentPage}.`} canonicalPath={`/blog/page/${currentPage}/`}>
  <PageHeader title="Blog" eyebrow={`${totalPosts} articles · page ${currentPage} of ${totalPages}`}>
    <p>Writing on Linux, software, hardware, and the tools that make computing more interesting.</p>
  </PageHeader>
  <div class="grid gap-4" data-reveal-list>
    {posts.map((post) => <PostCard post={post} />)}
  </div>
  <Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
