---
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { getPostNeighbors, getPostSlug, getPublishedPosts, type BlogPost } from '@/lib/content';

interface Props {
  post: BlogPost;
  newer?: BlogPost;
  older?: BlogPost;
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post, ...getPostNeighbors(posts, post) },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} newer={newer} older={older}>
  <Content />
</PostLayout>
