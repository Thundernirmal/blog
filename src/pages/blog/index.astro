---
import { FileTextIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PostCard from '@/components/blog/PostCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';
import { POSTS_PER_PAGE } from '@/config';
import { getPublishedPosts } from '@/lib/content';

const posts = await getPublishedPosts();
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
---

<BaseLayout title="Blog" description="All articles from Nirmal's Notes." canonicalPath="/blog/">
  <PageHeader title="Blog" eyebrow={`${posts.length} ${posts.length === 1 ? 'article' : 'articles'}`}>
    <p>Writing on Linux, software, hardware, and the tools that make computing more interesting.</p>
  </PageHeader>

  {visiblePosts.length > 0 ? (
    <div class="grid gap-4" data-reveal-list>
      {visiblePosts.map((post) => <PostCard post={post} />)}
    </div>
  ) : (
    <Empty className="border">
      <EmptyHeader>
        <EmptyMedia variant="icon"><FileTextIcon aria-hidden="true" /></EmptyMedia>
        <EmptyTitle>No Articles Yet</EmptyTitle>
        <EmptyDescription>New writing will appear here after it is published.</EmptyDescription>
      </EmptyHeader>
    </Empty>
  )}

  <Pagination currentPage={1} totalPages={totalPages} />
</BaseLayout>
