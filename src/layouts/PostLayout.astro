---
import { ExternalLinkIcon, InfoIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { Separator } from '@/components/ui/separator';
import PostMeta from '@/components/blog/PostMeta.astro';
import TagList from '@/components/blog/TagList.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import PostNavigation from '@/components/blog/PostNavigation.astro';
import { SITE } from '@/config';
import type { BlogPost } from '@/lib/content';
import { getPostReadingTime, getPostSlug, getPostUrl } from '@/lib/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: BlogPost;
  headings: Heading[];
  newer?: BlogPost;
  older?: BlogPost;
}

const { post, headings, newer, older } = Astro.props;
const url = getPostUrl(post);
const slug = getPostSlug(post);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: SITE.authorUrl },
  publisher: { '@type': 'Person', name: SITE.author, url: SITE.authorUrl },
  mainEntityOfPage: new URL(url, SITE.url).toString(),
  keywords: post.data.tags.join(', '),
};
const editUrl = `${SITE.githubUrl}/edit/main/src/content/blog/${slug}/index.md`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={url}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  structuredData={structuredData}
>
  <article class="grid min-w-0 gap-8" data-pagefind-body>
    <header class="mx-auto grid w-full min-w-0 max-w-3xl grid-cols-[minmax(0,1fr)] gap-5">
      <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb" data-pagefind-ignore>
        <ol class="flex min-w-0 items-center gap-2">
          <li><a class="rounded-sm hover:text-primary focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none" href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="rounded-sm hover:text-primary focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none" href="/blog/">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="min-w-0 flex-1 truncate">{post.data.title}</li>
        </ol>
      </nav>
      <h1 class="text-balance text-4xl font-semibold leading-tight tracking-tight sm:text-5xl" data-pagefind-meta="title">{post.data.title}</h1>
      <p class="text-pretty text-lg leading-8 text-muted-foreground">{post.data.description}</p>
      <PostMeta publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt} readingMinutes={getPostReadingTime(post)} />
      <div data-pagefind-meta={`tags:${post.data.tags.join(', ')}`}>
        <TagList tags={post.data.tags} />
      </div>
    </header>

    {(post.data.originalUrl || post.data.archived) && (
      <div class="mx-auto w-full max-w-3xl" data-pagefind-ignore>
        <Alert role="note">
          <InfoIcon aria-hidden="true" />
          <AlertTitle>From the Archive</AlertTitle>
          <AlertDescription>
            This article was originally published in {post.data.publishedAt.getUTCFullYear()}. Some technical details may have changed.
            {post.data.originalUrl && (
              <> <a href={post.data.originalUrl}>Read the original on Medium <ExternalLinkIcon className="ml-0.5 inline size-3.5" aria-hidden="true" /></a>.</>
            )}
          </AlertDescription>
        </Alert>
      </div>
    )}

    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,720px)_220px] lg:justify-center lg:items-start">
      <div class="article-prose min-w-0">
        <slot />
      </div>
      <TableOfContents headings={headings} />
    </div>
  </article>

  <div class="mx-auto grid w-full min-w-0 max-w-3xl grid-cols-[minmax(0,1fr)] gap-6" data-pagefind-ignore>
    <Separator />
    <TagList tags={post.data.tags} />
    <div class="flex flex-wrap items-center justify-between gap-3 text-sm text-muted-foreground">
      <span>Found something to improve?</span>
      <a class="rounded-sm font-medium text-primary underline-offset-4 hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none" href={editUrl}>Edit on GitHub</a>
    </div>
    <PostNavigation newer={newer} older={older} />
  </div>
</BaseLayout>
