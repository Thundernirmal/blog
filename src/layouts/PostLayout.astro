---
import { ExternalLinkIcon, InfoIcon } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { Separator } from '@/components/ui/separator';
import PostMeta from '@/components/blog/PostMeta.astro';
import TagList from '@/components/blog/TagList.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import PostNavigation from '@/components/blog/PostNavigation.astro';
import ShareButton from '@/components/blog/ShareButton.astro';
import { SITE } from '@/config';
import type { BlogPost } from '@/lib/content';
import { getPostReadingTime, getPostUrl } from '@/lib/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: BlogPost;
  headings: Heading[];
  newer?: BlogPost;
  older?: BlogPost;
}

const { post, headings, newer, older } = Astro.props;
const url = getPostUrl(post);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: SITE.authorUrl },
  publisher: { '@type': 'Person', name: SITE.author, url: SITE.authorUrl },
  mainEntityOfPage: new URL(url, SITE.url).toString(),
  keywords: post.data.tags.join(', '),
  ...(post.data.heroImage && { image: new URL(post.data.heroImage.src, SITE.url).toString() }),
};
const socialImage = post.data.heroImage;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={url}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  image={socialImage?.src}
  imageAlt={post.data.heroAlt ?? post.data.title}
  imageWidth={socialImage?.width}
  imageHeight={socialImage?.height}
  imageType={socialImage ? `image/${socialImage.format === 'jpg' ? 'jpeg' : socialImage.format}` : undefined}
  tags={post.data.tags}
  author={SITE.authorUrl}
  structuredData={structuredData}
>
  {/* Every block shares .post-column's grid, so the header, notes, prose and footer all start on the same edge. */}
  <article class="grid min-w-0 gap-7 sm:gap-8" data-pagefind-body>
    <div class="post-column">
      <header class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-4 sm:gap-5">
      {/* The breadcrumb uses nirmalkatariya.com's uppercase label. */}
      <nav class="label text-muted-foreground" aria-label="Breadcrumb" data-pagefind-ignore>
        <a class="inline-flex min-h-11 w-fit items-center gap-2 outline-none hover:text-primary focus-visible:ring-3 focus-visible:ring-ring sm:hidden" href="/blog/">
          <span aria-hidden="true">←</span>
          Back to Blog
        </a>
        <ol class="hidden min-w-0 items-center gap-2 sm:flex">
          <li><a class="rounded-sm hover:text-primary focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none" href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="rounded-sm hover:text-primary focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none" href="/blog/">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="min-w-0 flex-1 truncate">{post.data.title}</li>
        </ol>
      </nav>
      <h1 class="display text-balance wrap-anywhere text-[2.25rem] leading-none min-[360px]:text-[2.5rem] sm:text-6xl" data-pagefind-meta="title">{post.data.title}</h1>
      <p class="text-pretty text-base leading-7 text-muted-foreground min-[360px]:text-lg min-[360px]:leading-8" data-pagefind-meta="description">{post.data.description}</p>
      <PostMeta publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt} readingMinutes={getPostReadingTime(post)} />
      <div data-pagefind-meta={`tags:${post.data.tags.join(', ')}`}>
        <TagList tags={post.data.tags} />
      </div>
    </header>
    </div>

    {(post.data.originalUrl || post.data.archived) && (
      <div class="post-column" data-pagefind-ignore>
        <Alert role="note">
          <InfoIcon aria-hidden="true" />
          <AlertTitle>From the Archive</AlertTitle>
          <AlertDescription>
            This article was originally published in {post.data.publishedAt.getUTCFullYear()}. Some technical details may have changed.
            {post.data.originalUrl && (
              <> <a href={post.data.originalUrl}>Read the original on Medium <ExternalLinkIcon className="ml-0.5 inline size-3.5" aria-hidden="true" /></a>.</>
            )}
          </AlertDescription>
        </Alert>
      </div>
    )}

    <div class="post-column gap-y-8 lg:items-start">
      <div class="article-prose min-w-0">
        <slot />
      </div>
      <TableOfContents headings={headings} />
    </div>
  </article>

  <div class="post-column" data-pagefind-ignore>
    <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] gap-6">
      <Separator />
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <TagList tags={post.data.tags} />
        <ShareButton title={post.data.title} text={post.data.description} />
      </div>
      <PostNavigation newer={newer} older={older} />
    </div>
  </div>
</BaseLayout>
