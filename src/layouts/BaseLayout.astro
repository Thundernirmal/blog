---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SEO from '@/components/seo/SEO.astro';
import { SITE } from '@/config';
import { ClientRouter } from 'astro:transitions';
import sansFont from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-standard-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  author?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  mainClass?: string;
}

const { mainClass = '', ...seoProps } = Astro.props;
const isArticle = seoProps.type === 'article';
---

<!doctype html>
<html lang={SITE.language} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1e1e2e" />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <SEO {...seoProps} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="flex min-h-screen w-full flex-col">
      <Header readingProgress={isArticle} />
      <main
        id="main-content"
        tabindex="-1"
        data-page-enter
        transition:name="page-content"
        transition:animate="fade"
        class:list={['content-shell grid grid-cols-[minmax(0,1fr)] flex-1 content-start gap-8 py-8 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring sm:py-14', mainClass]}
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
