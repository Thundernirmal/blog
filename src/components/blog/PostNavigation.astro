---
import type { BlogPost } from '@/lib/content';
import { getPostUrl } from '@/lib/content';

interface Props {
  newer?: BlogPost;
  older?: BlogPost;
}

const { newer, older } = Astro.props;
---

{/* The home page's ruled band: two cells split by a hairline, each a label eyebrow over a display-weight title. */}
{(newer || older) && (
  <nav class="post-nav" aria-label="Article navigation" data-pagefind-ignore>
    {older && (
      <a class="post-nav-cell" href={getPostUrl(older)}>
        <span class="label text-muted-foreground"><span class="home-cta-arrow" aria-hidden="true">←</span> Older</span>
        <span class="post-nav-title">{older.data.title}</span>
      </a>
    )}
    {newer && (
      <a class="post-nav-cell post-nav-newer" href={getPostUrl(newer)}>
        <span class="label text-muted-foreground">Newer <span class="home-cta-arrow" aria-hidden="true">→</span></span>
        <span class="post-nav-title">{newer.data.title}</span>
      </a>
    )}
  </nav>
)}
