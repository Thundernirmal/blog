---
import TagButton from '@/components/blog/TagButton.astro';

interface Props {
  tags: string[];
  limit?: number;
}

const { tags, limit } = Astro.props;
const visibleTags = typeof limit === 'number' ? tags.slice(0, limit) : tags;
---

{visibleTags.length > 0 && (
  <ul class="flex flex-wrap gap-2" aria-label="Tags">
    {visibleTags.map((tag) => (
      <li>
        <TagButton tag={tag} />
      </li>
    ))}
  </ul>
)}
