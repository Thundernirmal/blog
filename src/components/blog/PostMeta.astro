---
import { formatDate } from '@/lib/dates';

interface Props {
  publishedAt: Date;
  updatedAt?: Date;
  readingMinutes: number;
}

const { publishedAt, updatedAt, readingMinutes } = Astro.props;
const hasMeaningfulUpdate = updatedAt && updatedAt.getTime() - publishedAt.getTime() >= 24 * 60 * 60 * 1000;
---

{/* One uppercase "DATE · N MIN READ · UPDATED DATE" label, shared by article headers and listings. The update
    note moves to a new line as a unit, so its date never splits (unless it alone is too wide). */}
<p class="label leading-5 text-muted-foreground" data-post-meta>
  <time datetime={publishedAt.toISOString()} data-pagefind-meta="date">{formatDate(publishedAt)}</time> · {readingMinutes} min read
  {hasMeaningfulUpdate && updatedAt && <> · <span class="inline-block" data-updated>Updated <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></span></>}
</p>
