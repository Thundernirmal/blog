---
import PostMeta from '@/components/blog/PostMeta.astro';
import TagList from '@/components/blog/TagList.astro';
import type { BlogPost } from '@/lib/content';
import { getPostReadingTime, getPostUrl } from '@/lib/content';

interface Props {
  post: BlogPost;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const url = getPostUrl(post);
const Heading = headingLevel;
---

{/* A ruled card like nirmalkatariya.com's: a display-weight title and an uppercase label link. */}
<article class="post-card">
  <Heading class="text-balance text-2xl leading-tight font-medium tracking-[-0.025em]">
    <a class="outline-none hover:text-primary focus-visible:ring-3 focus-visible:ring-ring/50" href={url}>{post.data.title}</a>
  </Heading>
  <p class="text-pretty leading-7 text-muted-foreground">{post.data.description}</p>
  <PostMeta publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt} readingMinutes={getPostReadingTime(post)} />
  <TagList tags={post.data.tags} limit={3} />
  <a class="home-cta label mt-auto" href={url}>
    <span>Read article<span class="sr-only">: {post.data.title}</span></span>
    <span class="home-cta-arrow" aria-hidden="true">→</span>
  </a>
</article>
