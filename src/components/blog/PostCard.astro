---
import { BookOpenIcon } from 'lucide-react';
import LabelLink from '@/components/LabelLink.astro';
import PostMeta from '@/components/blog/PostMeta.astro';
import TagList from '@/components/blog/TagList.astro';
import type { BlogPost } from '@/lib/content';
import { getPostReadingTime, getPostUrl } from '@/lib/content';

interface Props {
  post: BlogPost;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const url = getPostUrl(post);
const Heading = headingLevel;
const { publishedAt, updatedAt } = post.data;
---

{/* One row of a continuous ruled list, led by the same meta label as article headers. */}
<article class="post-row">
  <PostMeta publishedAt={publishedAt} updatedAt={updatedAt} readingMinutes={getPostReadingTime(post)} />
  <Heading class="text-balance text-2xl leading-tight font-medium tracking-[-0.025em] sm:text-3xl">
    <a class="outline-none hover:text-primary focus-visible:ring-3 focus-visible:ring-ring" href={url}>{post.data.title}</a>
  </Heading>
  <p class="max-w-2xl text-pretty leading-7 text-muted-foreground">{post.data.description}</p>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
    <TagList tags={post.data.tags} limit={3} />
    <LabelLink href={url} icon={BookOpenIcon}>Read article<span class="sr-only">: {post.data.title}</span></LabelLink>
  </div>
</article>
