---
interface Props {
  id?: string;
  title: string;
  eyebrow?: string;
  hero?: boolean;
}

const { id, title, eyebrow, hero = false } = Astro.props;
---

<header id={id} class="grid max-w-3xl gap-3 motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2">
  {eyebrow && <p class="font-mono text-sm font-medium text-primary">{eyebrow}</p>}
  <h1 class:list={['text-balance font-semibold tracking-tight', hero ? 'text-[2.5rem] leading-[1.1] sm:text-6xl' : 'text-4xl sm:text-5xl']}>
    {title}
  </h1>
  <div class="text-pretty text-base leading-7 text-muted-foreground sm:text-lg">
    <slot />
  </div>
</header>
