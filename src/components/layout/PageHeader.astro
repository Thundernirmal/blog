---
interface Props {
  id?: string;
  title: string;
  eyebrow?: string;
  hero?: boolean;
}

const { id, title, eyebrow, hero = false } = Astro.props;
const titleParts = title.trim().split(/\s+/);
const titleAccent = titleParts.pop() ?? title;
const titleLead = titleParts.join(' ');
---

<header id={id} class="grid max-w-3xl gap-4 sm:gap-5">
  {eyebrow && <p class="label text-primary">{eyebrow}</p>}
  <h1 class:list={['display text-balance break-words text-foreground', hero ? 'text-[clamp(3rem,10vw,5.5rem)]' : 'text-[2.75rem] sm:text-6xl']}>
    {hero && titleLead ? (
      <><span class="text-primary">{titleLead}</span>{' '}<span class="text-foreground">{titleAccent}</span></>
    ) : title}
  </h1>
  <div class="text-pretty text-base leading-7 text-muted-foreground sm:text-lg">
    <slot />
  </div>
</header>
