---
import { Separator } from '@/components/ui/separator';
import { SITE } from '@/config';
---

<footer class="w-full" transition:name="site-footer" transition:animate="none">
  <Separator />
  <div class="content-shell grid gap-2 py-6 text-sm leading-6 text-muted-foreground sm:flex sm:flex-wrap sm:items-center sm:justify-between">
    {/* Phones wrap this row, so the dots give way to spacing there and no line starts with a stray "·". */}
    <p class="flex flex-wrap items-center gap-x-4 gap-y-1 sm:gap-x-2">
      <span class="inline-flex items-center gap-x-2">Built by <a class="footer-link" href={SITE.authorUrl}>{SITE.author}</a></span>
      <span class="inline-flex items-center gap-x-2"><span class="hidden sm:inline" aria-hidden="true">·</span><a class="footer-link" href={SITE.githubUrl}>Source</a></span>
      <span class="inline-flex items-center gap-x-2"><span class="hidden sm:inline" aria-hidden="true">·</span><a class="footer-link" href={SITE.mediumUrl}>Medium</a></span>
      <span class="inline-flex items-center gap-x-2"><span class="hidden sm:inline" aria-hidden="true">·</span><a class="footer-link" href="/rss.xml">RSS</a></span>
    </p>
    {/* Like nirmalkatariya.com's footer, name the Catppuccin flavour in view. */}
    <p class="flex flex-wrap items-center gap-x-2">
      <span>Powered by Astro</span>
      <span class="inline-flex items-center gap-x-2"><span aria-hidden="true">·</span><span>In Catppuccin <span class="footer-theme-name"></span></span></span>
    </p>
  </div>
</footer>
