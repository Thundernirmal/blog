---
import { Separator } from '@/components/ui/separator';
import { SITE } from '@/config';
---

<footer class="w-full" transition:name="site-footer" transition:animate="none">
  <Separator />
  <div class="content-shell py-5 text-sm leading-6 text-muted-foreground">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
      Built by <a class="inline-flex min-h-11 items-center rounded-sm underline-offset-4 hover:text-primary hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none sm:min-h-6" href={SITE.authorUrl}>{SITE.author}</a>
      <span aria-hidden="true">·</span>
      <a class="inline-flex min-h-11 items-center rounded-sm underline-offset-4 hover:text-primary hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none sm:min-h-6" href={SITE.githubUrl}>Source</a>
      <span aria-hidden="true">·</span>
      <a class="inline-flex min-h-11 items-center rounded-sm underline-offset-4 hover:text-primary hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none sm:min-h-6" href={SITE.mediumUrl}>Medium</a>
      <span aria-hidden="true">·</span>
      <a class="inline-flex min-h-11 items-center rounded-sm underline-offset-4 hover:text-primary hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none sm:min-h-6" href="/rss.xml">RSS</a>
      <span aria-hidden="true">·</span>
      <span>Powered by Astro & Catppuccin Mocha</span>
    </p>
  </div>
</footer>
