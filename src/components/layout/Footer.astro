---
import { Separator } from '@/components/ui/separator';
import { SITE } from '@/config';
---

<footer class="w-full" transition:name="site-footer" transition:animate="none">
  <Separator />
  <div class="content-shell grid gap-2 py-6 text-sm leading-6 text-muted-foreground sm:flex sm:flex-wrap sm:items-center sm:justify-between">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
      Built by <a class="footer-link" href={SITE.authorUrl}>{SITE.author}</a>
      <span aria-hidden="true">·</span>
      <a class="footer-link" href={SITE.githubUrl}>Source</a>
      <span aria-hidden="true">·</span>
      <a class="footer-link" href={SITE.mediumUrl}>Medium</a>
      <span aria-hidden="true">·</span>
      <a class="footer-link" href="/rss.xml">RSS</a>
    </p>
    {/* Like nirmalkatariya.com's footer, name the Catppuccin flavour in view. */}
    <p>Powered by Astro · In Catppuccin <span class="footer-theme-name"></span></p>
  </div>
</footer>
