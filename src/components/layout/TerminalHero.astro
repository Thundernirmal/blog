---
import { ChevronRightIcon, TerminalIcon } from 'lucide-react';
import type { BlogPost } from '@/lib/content';
import { getPostUrl } from '@/lib/content';

interface Props {
  latest?: BlogPost;
}

const { latest } = Astro.props;
---

<figure class="overflow-hidden rounded-xl border bg-terminal-background shadow-lg motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-2">
  <figcaption class="sr-only">A terminal-style preview of the latest article.</figcaption>
  <div class="grid grid-cols-[1fr_auto_1fr] items-center border-b bg-terminal-toolbar px-3 py-2.5">
    <span class="flex size-7 items-center justify-center rounded-lg bg-background/40" aria-hidden="true">
      <TerminalIcon className="size-4 text-primary" />
    </span>
    <span class="truncate text-center text-sm font-semibold">nirmal@Tiger: ~/notes</span>
    <span class="flex justify-self-end gap-1" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-status-negative"></span>
      <span class="size-2.5 rounded-full bg-status-caution"></span>
      <span class="size-2.5 rounded-full bg-status-positive"></span>
    </span>
  </div>
  <div class="grid gap-3 p-5 font-mono text-sm leading-7 sm:p-6">
    <p class="flex flex-wrap items-center gap-2">
      <span class="text-terminal-user">nirmal@Tiger</span>
      <span class="text-terminal-path">~/notes</span>
      <ChevronRightIcon className="size-4 text-muted-foreground" aria-hidden="true" />
      <span>latest</span>
    </p>
    {latest ? (
      <p>
        <span class="text-primary">article:</span>{' '}
        <a class="rounded-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:outline-none" href={getPostUrl(latest)}>{latest.data.title}</a>
      </p>
    ) : (
      <p class="text-muted-foreground">New writing is on the way.</p>
    )}
  </div>
</figure>
