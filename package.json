{
  "name": "nirmals-notes",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24.18.1",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "predev": "npm run search:sync",
    "dev": "astro dev",
    "dev:stop": "astro dev stop",
    "prestart": "npm run search:sync",
    "start": "astro dev",
    "check": "astro check",
    "prebuild": "node scripts/clean-pagefind-for-build.mjs",
    "build": "astro build && pagefind --site dist",
    "search:sync": "npm run build && node scripts/sync-pagefind-for-dev.mjs",
    "preview": "astro preview",
    "import:medium": "node scripts/import-medium.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "test:e2e": "playwright test",
    "test": "npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@pagefind/component-ui": "^1.5.2",
    "astro": "^7.2.0",
    "astro-expressive-code": "^0.44.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.2.5",
    "pagefind": "^1.5.2",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.1",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
